#!/usr/bin/env bash
set -Eeuo pipefail

HOME_DIR="${SBX_HOME:-/opt/singbox-manager}"
export SBX_HOME="$HOME_DIR"
# 版本号以安装目录的 VERSION 文件为唯一来源，避免多处硬编码互相矛盾。
VERSION=""
if [[ -f "$HOME_DIR/VERSION" ]]; then
  VERSION="$(tr -d '[:space:]' < "$HOME_DIR/VERSION" 2>/dev/null || true)"
fi
[[ -n "$VERSION" ]] || VERSION="unknown"
COMPOSE="$HOME_DIR/compose.yml"
ENV="$HOME_DIR/.env"
CONFIG="$HOME_DIR/config/config.json"
NODES="$HOME_DIR/nodes/nodes.json"
HELPER="$HOME_DIR/lib/sbx_nodes.py"
BACKUPS="$HOME_DIR/backup"
INBOUND_COMPOSE="$HOME_DIR/compose.inbounds.yml"
NETWORK_COMPOSE="$HOME_DIR/compose.network.yml"
DOCKER_MANAGED="$HOME_DIR/docker-managed.json"

# 终端配色：按“黑色背景上也看得清”选色
#   C 主色（菜单标题/区块标题）—— 原来是暗青 36，黑底偏暗，现在默认明绿 92
#   G [INFO] 明绿 / Y [WARN] 明黄 / R [ERROR] 明红 / D 次要文字浅灰（原来纯 dim 偏暗）
# SBX_COLOR_ACCENT 可换主色（例如 96 明青、1;36 加粗青）；NO_COLOR=1 或 SBX_NO_COLOR=1 关闭全部颜色
if [[ -n "${NO_COLOR:-}" || "${SBX_NO_COLOR:-0}" == "1" ]]; then
  G=''; Y=''; R=''; C=''; N=''; D=''; B=''
else
  G='\033[92m'; Y='\033[93m'; R='\033[91m'; D='\033[37m'; N='\033[0m'
  C="\033[${SBX_COLOR_ACCENT:-92}m"
  B='\033[1m'
fi
info(){ printf '%b[INFO]%b %s\n' "$G" "$N" "$*"; }
warn(){ printf '%b[WARN]%b %s\n' "$Y" "$N" "$*" >&2; }
die(){ printf '%b[ERROR]%b %s\n' "$R" "$N" "$*" >&2; exit 1; }

# ── 菜单版式 ─────────────────────────────────────────────────────────────────
# 终端里的字号由终端自己决定（脚本改不了），这里能调的是：行距、缩进、列宽、
# 标题块与分隔线宽度。SBX_MENU_DENSITY=comfortable|compact 切换版式，
# 默认 comfortable；终端太窄（COLUMNS<60）时自动用 compact，避免折行。
menu_termsize(){ # 终端列数：COLUMNS → tput（COLUMNS 在子脚本里常常拿不到）→ 默认 52
  local w=""
  if [[ "${COLUMNS:-}" =~ ^[0-9]+$ ]]; then
    w="$COLUMNS"
  elif [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
    w="$(tput cols 2>/dev/null || true)"
  fi
  [[ "$w" =~ ^[0-9]+$ ]] || w=52
  printf '%s' "$w"
}
menu_density(){
  case "${SBX_MENU_DENSITY:-comfortable}" in
    compact|tight|0) printf 'compact'; return ;;
  esac
  # 窄终端自动回到紧凑版式，避免折行
  if (( $(menu_termsize) < 60 )); then
    printf 'compact'
    return
  fi
  printf 'comfortable'
}
menu_width(){ # 分隔线宽度：跟随终端，夹在 40..72
  local w
  w="$(menu_termsize)"
  if [[ "$(menu_density)" == "compact" ]]; then printf '42'; return; fi
  (( w > 72 )) && w=72
  (( w < 40 )) && w=40
  printf '%s' "$w"
}
menu_rule(){ # 分隔线
  local w i line=""
  w="$(menu_width)"
  for ((i=0;i<w;i++)); do line+="━"; done
  printf '%b%s%b\n' "$C" "$line" "$N"
}
menu_title(){ # 顶部标题块：分隔线 + 居中加粗标题 + 分隔线
  local text="$*" w pad
  w="$(menu_width)"
  pad=$(( (w - ${#text}) / 2 ))
  (( pad < 0 )) && pad=0
  [[ "$(menu_density)" == "compact" ]] || printf '\n'
  menu_rule
  printf '%b%b%*s%s%b\n' "$C" "$B" "$pad" "" "$text" "$N"
  menu_rule
}
menu_block(){ # 区块：标题 + 条目（条目从 stdin 传入，comfortable 下统一缩进并留行距）
  local title="$1"
  if [[ "$(menu_density)" == "compact" ]]; then
    printf '%b【%s】%b\n' "$C" "$title" "$N"
    cat
  else
    printf '\n  %b【%s】%b\n\n' "$C" "$title" "$N"
    sed 's/^/  /'
  fi
}
menu_note(){ # 标题下的一行次要信息（当前版本 / 当前策略…）
  if [[ "$(menu_density)" == "compact" ]]; then
    printf '%b%s%b\n\n' "$D" "$*" "$N"
  else
    printf '\n    %b%s%b\n' "$D" "$*" "$N"
  fi
}
menu_end(){ # comfortable 版式下补一条收尾分隔线
  [[ "$(menu_density)" == "compact" ]] || menu_rule
}
menu_footer(){ # 收尾项（0 返回 / 0 退出）
  if [[ "$(menu_density)" == "compact" ]]; then
    printf '%s\n' "$*"
  else
    printf '\n    %b%s%b\n\n' "$D" "$*" "$N"
  fi
}

root(){
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    command -v sudo >/dev/null 2>&1 && exec sudo -E -- "$0" "$@"
    die "该命令需要 root 权限。"
  fi
}
ready(){
  command -v python3 >/dev/null 2>&1 || die "未检测到 Python 3，请重新运行安装脚本。"
  command -v docker >/dev/null 2>&1 || die "未检测到 Docker。"
  docker compose version >/dev/null 2>&1 || die "未检测到 Docker Compose v2。"
  docker info >/dev/null 2>&1 || die "无法连接 Docker daemon。"
  [[ -f "$COMPOSE" && -f "$ENV" && -f "$HELPER" ]] || die "安装不完整，请重新运行安装脚本。"
  mkdir -p "$BACKUPS" "$HOME_DIR/nodes" "$HOME_DIR/config" "$HOME_DIR/data"
  [[ -f "$NODES" ]] || python3 "$HELPER" init >/dev/null
}
dc(){
  local args=(--project-directory "$HOME_DIR" --env-file "$ENV" -f "$COMPOSE")
  [[ -f "$INBOUND_COMPOSE" ]] && args+=(-f "$INBOUND_COMPOSE")
  if [[ -f "$NETWORK_COMPOSE" ]]; then
    if declare -F docker_network_prepare_if_enabled >/dev/null 2>&1; then
      docker_network_prepare_if_enabled
    fi
    args+=(-f "$NETWORK_COMPOSE")
  fi
  docker compose "${args[@]}" "$@"
}
envval(){ grep -E "^$1=" "$ENV" 2>/dev/null | tail -n1 | cut -d= -f2- || printf '%s' "$2"; }
setenv(){ # .env 是全量「读-改-写」，并发 sbx 会互相覆盖：整段用 flock 串行化（锁文件固定 $HOME_DIR/.sbx-env.lock）
  local k="$1" v="$2" t lock="$HOME_DIR/.sbx-env.lock" fd=""
  if command -v flock >/dev/null 2>&1; then
    # 先把锁文件打开成 fd，再在整段读-改-写期间持锁；-w 10 限制等待，超时给可读报错。
    if exec {fd}>"$lock"; then
      if ! flock -w 10 "$fd"; then
        exec {fd}>&-
        die "等待 .env 写锁超时（$lock 正被其它 sbx 进程占用），请稍后重试。"
      fi
    else
      fd=""
      warn "无法创建锁文件 $lock，本次 .env 写入没有并发保护。"
    fi
  else
    warn "未找到 flock（util-linux），.env 写入没有并发保护，可能与其它 sbx 调用互相覆盖。"
  fi
  t=$(mktemp); awk -v k="$k" -v v="$v" 'BEGIN{f=0} index($0,k"=")==1{print k"="v;f=1;next}{print} END{if(!f)print k"="v}' "$ENV">"$t"; cat "$t">"$ENV"; rm -f "$t"; chmod 600 "$ENV"
  if [[ -n "$fd" ]]; then exec {fd}>&-; fi
}
running(){ dc ps --status running --services 2>/dev/null | grep -qx sing-box; }
status(){ dc ps; }
stop(){ dc stop sing-box; }
logs(){ dc logs --tail=100 -f sing-box; }

BACKUP_RESULT=""
backup(){
  local d f t n=0; d=$(date '+%Y%m%d-%H%M%S'); f="$BACKUPS/sbx-$d.tar.gz"
  while [[ -e "$f" ]]; do n=$((n+1)); f="$BACKUPS/sbx-$d-$n.tar.gz"; done
  t=$(mktemp -d); mkdir -p "$t/snapshot"
  [[ -f "$CONFIG" ]] && cp -a "$CONFIG" "$t/snapshot/config.json"
  [[ -f "$NODES" ]] && cp -a "$NODES" "$t/snapshot/nodes.json"
  [[ -f "$INBOUND_COMPOSE" ]] && cp -a "$INBOUND_COMPOSE" "$t/snapshot/compose.inbounds.yml"
  [[ -f "$NETWORK_COMPOSE" ]] && cp -a "$NETWORK_COMPOSE" "$t/snapshot/compose.network.yml"
  [[ -f "$DOCKER_MANAGED" ]] && cp -a "$DOCKER_MANAGED" "$t/snapshot/docker-managed.json"
  cp -a "$ENV" "$t/snapshot/env"
  tar -czf "$f" -C "$t" snapshot; rm -rf "$t"; chmod 600 "$f"; BACKUP_RESULT="$f"; info "备份完成: $f"
}
restore_raw(){
  local f="$1" restore_env="${2:-yes}" t e line name
  while IFS= read -r e; do [[ "$e" != *".."* ]] || die "备份路径不安全"; case "$e" in snapshot|snapshot/|snapshot/config.json|snapshot/nodes.json|snapshot/compose.inbounds.yml|snapshot/compose.network.yml|snapshot/docker-managed.json|snapshot/env) ;; *) die "备份含未知路径: $e";; esac; done < <(tar -tzf "$f")
  # 成员类型白名单：只接受普通文件与目录。符号链接/硬链接/设备/FIFO 都能在解包阶段
  # 穿透到白名单目录之外（把 snapshot 做成指向别处的链接，后续成员就写到链接目标），
  # 必须在 tar -x 之前按类型拒绝。
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    # 名字是第 6 个字段起（含空格），这里只用于报错文案；类型看行首字符。
    read -r _ _ _ _ _ name <<<"$line" || true
    case "${line:0:1}" in
      -|d) ;;
      l|h) die "备份含链接成员（符号链接/硬链接），拒绝恢复: ${name:-$line}";;
      *) die "备份含特殊成员（设备文件/FIFO 等），拒绝恢复: ${name:-$line}";;
    esac
  done < <(tar -tvzf "$f")
  t=$(mktemp -d); tar -xzf "$f" -C "$t" --no-same-owner
  [[ -f "$t/snapshot/config.json" ]] && install -m600 "$t/snapshot/config.json" "$CONFIG"
  [[ -f "$t/snapshot/nodes.json" ]] && install -m600 "$t/snapshot/nodes.json" "$NODES"
  if [[ -f "$t/snapshot/compose.inbounds.yml" ]]; then install -m600 "$t/snapshot/compose.inbounds.yml" "$INBOUND_COMPOSE"; else rm -f "$INBOUND_COMPOSE"; fi
  if [[ -f "$t/snapshot/compose.network.yml" ]]; then install -m600 "$t/snapshot/compose.network.yml" "$NETWORK_COMPOSE"; else rm -f "$NETWORK_COMPOSE"; fi
  if [[ -f "$t/snapshot/docker-managed.json" ]]; then install -m600 "$t/snapshot/docker-managed.json" "$DOCKER_MANAGED"; else rm -f "$DOCKER_MANAGED"; fi
  [[ "$restore_env" == yes && -f "$t/snapshot/env" ]] && install -m600 "$t/snapshot/env" "$ENV"
  rm -rf "$t"
}
restore(){
  local f="${1:-}" rollback
  [[ -n "$f" ]] || f=$(ls -1t "$BACKUPS"/sbx-*.tar.gz 2>/dev/null | head -n1 || true)
  [[ "$f" == /* ]] || f="$BACKUPS/$f"; [[ -f "$f" ]] || die "未找到备份。"
  backup; rollback="$BACKUP_RESULT"; restore_raw "$f" yes
  if ! python3 "$HELPER" validate >/dev/null || ! check; then
    warn "恢复无效，正在回滚"; restore_raw "$rollback" yes; die "恢复失败，已回滚"
  fi
  if running; then
    restart || { warn "配置已恢复，但 sing-box 重启失败；请执行 sbx logs 检查。"; return 1; }
  fi
  info "恢复完成"
}

node_tx(){
  local op="$1" ref="${2:-}" rollback rc=0
  backup; rollback="$BACKUP_RESULT"
  case "$op" in
    add) python3 "$HELPER" add || rc=$?;;
    edit|delete|default) python3 "$HELPER" "$op" ${ref:+"$ref"} || rc=$?;;
  esac
  if ((rc)); then restore_raw "$rollback" no; return "$rc"; fi
  if ! python3 "$HELPER" validate >/dev/null || ! check; then warn "新节点配置未通过校验，自动回滚"; restore_raw "$rollback" no; return 1; fi
  if running; then
    restart || { warn "节点配置已写入磁盘，但 sing-box 重启失败；请执行 sbx logs 检查。"; return 1; }
  fi
  info "节点配置已生效。"
}
http_test(){
  local p="$1" code ip
  command -v curl >/dev/null 2>&1 || die "测试需要 curl。"
  code=$(curl --proxy "$p" --connect-timeout 5 --max-time 15 -sS -o /dev/null -w '%{http_code}' https://www.google.com/generate_204 2>/dev/null || true)
  if [[ "$code" != 204 ]]; then code=$(curl --proxy "$p" --connect-timeout 5 --max-time 15 -sS -o /dev/null -w '%{http_code}' https://github.com/ 2>/dev/null || true); [[ "$code" =~ ^(200|301|302)$ ]] || return 1; fi
  ip=$(curl --proxy "$p" --connect-timeout 5 --max-time 10 -sS https://api.ipify.org 2>/dev/null || true); [[ -n "$ip" ]] && info "代理出口 IP: $ip"; return 0
}
test_current(){ running || die "sing-box 未运行。"; local port host=127.0.0.1; port=$(envval SING_BOX_MIXED_PORT 7890); declare -F proxy_host >/dev/null 2>&1 && host="$(proxy_host)"; http_test "http://$host:$port" && info "当前代理测试通过。" || die "当前代理测试失败。"; }
edit(){ local e="${SBX_EDITOR:-${EDITOR:-vi}}"; command -v "$e" >/dev/null || die "找不到编辑器 $e"; backup; warn "config.json 由节点库生成，后续节点操作会覆盖手工改动。"; "$e" "$CONFIG"; check; }

pause(){ read -r -p '按 Enter 返回...' _ || true; }
# 条目版式约定见 lib/sbx_v3.sh 顶部注释：编号 + 名称(补到 10 显示列) + 说明(≤24 显示列)。
# 「重建配置」不在这里：增删改已经会自动重建并重启，手动重建属于修复动作，放在【服务】里。
node_menu(){
  local x r p='序号(留空可列表选择): '
  while true; do
    clear
    menu_title '节点管理'
    menu_note '序号即操作时填的值，改动会自动生效。'
    menu_block '查看' <<'EOF'
   1  列表        查看全部节点
   2  详情        查看节点完整配置
   3  测试        测试节点能否连通
EOF
    menu_block '操作' <<'EOF'
   4  添加        粘贴分享链接或手动填写
   5  编辑        修改已有节点
   6  删除        删除某个节点
   7  默认        设为默认出口
EOF
    menu_footer '0  返回'
    menu_end
    read -r -p '请选择: ' x || return
    case "$x" in
      1) node list ;;
      2) read -r -p "$p" r; python3 "$HELPER" show ${r:+"$r"} || true ;;
      3) read -r -p "$p" r; test_node "$r" || true ;;
      4) node_tx add ;;
      5) read -r -p "$p" r; node_tx edit "$r" || true ;;
      6) read -r -p "$p" r; node_tx delete "$r" || true ;;
      7) read -r -p "$p" r; node_tx default "$r" || true ;;
      0) return ;;
      *) warn "无效选项" ;;
    esac
    [[ "$x" != 0 ]] && pause
  done
}
# 缺任何一个 lib 都要给可读的报错。否则后面只会在 case 分发处报
# "main: command not found"，或者更糟：静默少掉某个子命令。
SBX_LIBS=(sbx_v3.sh sbx_proxy.sh sbx_bootstrap.sh sbx_image.sh sbx_inbound.sh sbx_docker_network.sh sbx_update.sh)
for _lib in "${SBX_LIBS[@]}"; do
  [[ -f "$HOME_DIR/lib/$_lib" ]] || die "缺少 $HOME_DIR/lib/$_lib，安装不完整。请重新运行 sbx-install（或把 SBX_HOME 指向正确的安装目录）。"
done
# 以 root 运行时，lib 里每一行都以 root 身份执行；而本脚本自己会用 `sudo -E` 把调用者的
# SBX_HOME 带进 root 会话。若某个用户只被授予「能跑 sbx」的受限 sudo，他就能把 SBX_HOME
# 指向自己的目录，让 root 加载他写的 lib —— 等于提权。所以在 source 之前先校验 lib 文件
# 的属主与权限：必须 root 所有，且 group/other 不可写。
# 只校验文件本身，不校验目录属主：CI 里安装目录可能归 runner 用户所有，lib 是 root 装的 0755。
if [[ ${EUID:-$(id -u)} -eq 0 && "${SBX_ALLOW_UNSAFE_LIB:-0}" != "1" ]]; then
  for _lib in "${SBX_LIBS[@]}"; do
    _libf="$HOME_DIR/lib/$_lib"
    _mode="$(stat -c '%a' "$_libf" 2>/dev/null || true)"
    if [[ ! -O "$_libf" ]]; then
      die "lib 文件可被非 root 用户修改，拒绝以 root 加载: $_libf"
    elif [[ "$_mode" =~ ^[0-7]{3,4}$ ]]; then
      (( (8#$_mode & 8#22) == 0 )) || die "lib 文件可被非 root 用户修改，拒绝以 root 加载: $_libf"
    else
      warn "无法通过 stat 读取 $_libf 的权限位，仅校验了属主。"
    fi
  done
elif [[ ${EUID:-$(id -u)} -eq 0 ]]; then
  warn "SBX_ALLOW_UNSAFE_LIB=1：已跳过 lib 属主/权限校验。以 root 加载非 root 所有或可被他人修改的代码，等同于把 root 权限交给对方，请确认目录可信。"
fi
unset _lib _libf _mode
[[ -f "$HOME_DIR/lib/sbx_v3.sh" ]] && source "$HOME_DIR/lib/sbx_v3.sh"
[[ -f "$HOME_DIR/lib/sbx_proxy.sh" ]] && source "$HOME_DIR/lib/sbx_proxy.sh"
[[ -f "$HOME_DIR/lib/sbx_bootstrap.sh" ]] && source "$HOME_DIR/lib/sbx_bootstrap.sh"
[[ -f "$HOME_DIR/lib/sbx_image.sh" ]] && source "$HOME_DIR/lib/sbx_image.sh"
[[ -f "$HOME_DIR/lib/sbx_inbound.sh" ]] && source "$HOME_DIR/lib/sbx_inbound.sh"
[[ -f "$HOME_DIR/lib/sbx_docker_network.sh" ]] && source "$HOME_DIR/lib/sbx_docker_network.sh"
[[ -f "$HOME_DIR/lib/sbx_update.sh" ]] && source "$HOME_DIR/lib/sbx_update.sh"
if [[ "${1:-}" == "image" ]]; then
  root "$@"
  ready
  shift || true
  image_cmd "$@"
else
  main "$@"
fi
