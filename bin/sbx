#!/usr/bin/env bash
set -Eeuo pipefail

VERSION="0.2.0"
HOME_DIR="${SBX_HOME:-/opt/singbox-manager}"
COMPOSE="$HOME_DIR/compose.yml"
ENV="$HOME_DIR/.env"
CONFIG="$HOME_DIR/config/config.json"
NODES="$HOME_DIR/nodes/nodes.json"
HELPER="$HOME_DIR/lib/sbx_nodes.py"
BACKUPS="$HOME_DIR/backup"
INBOUND_COMPOSE="$HOME_DIR/compose.inbounds.yml"

G='\033[32m'; Y='\033[33m'; R='\033[31m'; C='\033[36m'; N='\033[0m'
info(){ printf '%b[INFO]%b %s\n' "$G" "$N" "$*"; }
warn(){ printf '%b[WARN]%b %s\n' "$Y" "$N" "$*" >&2; }
die(){ printf '%b[ERROR]%b %s\n' "$R" "$N" "$*" >&2; exit 1; }

root(){
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    command -v sudo >/dev/null 2>&1 && exec sudo -- "$0" "$@"
    die "该命令需要 root 权限。"
  fi
}
ready(){
  command -v python3 >/dev/null 2>&1 || die "未检测到 Python 3，请重新运行安装脚本。"
  command -v docker >/dev/null 2>&1 || die "未检测到 Docker。"
  docker compose version >/dev/null 2>&1 || die "未检测到 Docker Compose v2。"
  docker info >/dev/null 2>&1 || die "无法连接 Docker daemon。"
  [[ -f "$COMPOSE" && -f "$ENV" && -f "$HELPER" ]] || die "安装不完整，请重新运行安装脚本。"
  mkdir -p "$BACKUPS" "$HOME_DIR/nodes" "$HOME_DIR/config" "$HOME_DIR/data"
  [[ -f "$NODES" ]] || python3 "$HELPER" init >/dev/null
}
dc(){
  local args=(--project-directory "$HOME_DIR" --env-file "$ENV" -f "$COMPOSE")
  [[ -f "$INBOUND_COMPOSE" ]] && args+=(-f "$INBOUND_COMPOSE")
  docker compose "${args[@]}" "$@"
}
envval(){ grep -E "^$1=" "$ENV" 2>/dev/null | tail -n1 | cut -d= -f2- || printf '%s' "$2"; }
setenv(){ local k="$1" v="$2" t; t=$(mktemp); awk -v k="$k" -v v="$v" 'BEGIN{f=0} index($0,k"=")==1{print k"="v;f=1;next}{print} END{if(!f)print k"="v}' "$ENV">"$t"; cat "$t">"$ENV"; rm -f "$t"; chmod 600 "$ENV"; }
running(){ dc ps --status running --services 2>/dev/null | grep -qx sing-box; }
check(){ info "检查 sing-box 配置..."; dc run --rm --no-deps sing-box check -c /etc/sing-box/config.json -D /var/lib/sing-box; }
status(){ dc ps; }
start(){ check || die "配置检查失败。"; dc up -d sing-box; status; }
stop(){ dc stop sing-box; }
restart(){ check || die "配置检查失败，未替换运行容器。"; dc up -d --force-recreate sing-box; status; }
logs(){ dc logs --tail=100 -f sing-box; }

BACKUP_RESULT=""
backup(){
  local d f t; d=$(date '+%Y%m%d-%H%M%S'); f="$BACKUPS/sbx-$d.tar.gz"; t=$(mktemp -d); mkdir -p "$t/snapshot"
  [[ -f "$CONFIG" ]] && cp -a "$CONFIG" "$t/snapshot/config.json"
  [[ -f "$NODES" ]] && cp -a "$NODES" "$t/snapshot/nodes.json"
  [[ -f "$INBOUND_COMPOSE" ]] && cp -a "$INBOUND_COMPOSE" "$t/snapshot/compose.inbounds.yml"
  cp -a "$ENV" "$t/snapshot/env"
  tar -czf "$f" -C "$t" snapshot; rm -rf "$t"; chmod 600 "$f"; BACKUP_RESULT="$f"; info "备份完成: $f"
}
restore_raw(){
  local f="$1" restore_env="${2:-yes}" t e
  while IFS= read -r e; do [[ "$e" != *".."* ]] || die "备份路径不安全"; case "$e" in snapshot|snapshot/|snapshot/config.json|snapshot/nodes.json|snapshot/compose.inbounds.yml|snapshot/env) ;; *) die "备份含未知路径: $e";; esac; done < <(tar -tzf "$f")
  t=$(mktemp -d); tar -xzf "$f" -C "$t"
  [[ -f "$t/snapshot/config.json" ]] && install -m600 "$t/snapshot/config.json" "$CONFIG"
  [[ -f "$t/snapshot/nodes.json" ]] && install -m600 "$t/snapshot/nodes.json" "$NODES"
  if [[ -f "$t/snapshot/compose.inbounds.yml" ]]; then install -m600 "$t/snapshot/compose.inbounds.yml" "$INBOUND_COMPOSE"; else rm -f "$INBOUND_COMPOSE"; fi
  [[ "$restore_env" == yes && -f "$t/snapshot/env" ]] && install -m600 "$t/snapshot/env" "$ENV"
  rm -rf "$t"
}
restore(){
  local f="${1:-}" rollback
  [[ -n "$f" ]] || f=$(ls -1t "$BACKUPS"/sbx-*.tar.gz 2>/dev/null | head -n1 || true)
  [[ "$f" == /* ]] || f="$BACKUPS/$f"; [[ -f "$f" ]] || die "未找到备份。"
  backup; rollback="$BACKUP_RESULT"; restore_raw "$f" yes
  if python3 "$HELPER" validate >/dev/null && check; then info "恢复完成"; running && restart || true; else warn "恢复无效，正在回滚"; restore_raw "$rollback" yes; die "恢复失败，已回滚"; fi
}

node_tx(){
  local op="$1" ref="${2:-}" rollback rc=0
  backup; rollback="$BACKUP_RESULT"
  case "$op" in
    add) python3 "$HELPER" add || rc=$?;;
    edit|delete|default) python3 "$HELPER" "$op" ${ref:+"$ref"} || rc=$?;;
  esac
  if ((rc)); then restore_raw "$rollback" no; return "$rc"; fi
  if ! python3 "$HELPER" validate >/dev/null || ! check; then warn "新节点配置未通过校验，自动回滚"; restore_raw "$rollback" no; return 1; fi
  info "节点配置已生效。"; running && restart || true
}
http_test(){
  local p="$1" code ip
  command -v curl >/dev/null 2>&1 || die "测试需要 curl。"
  code=$(curl --proxy "$p" --connect-timeout 5 --max-time 15 -sS -o /dev/null -w '%{http_code}' https://www.google.com/generate_204 2>/dev/null || true)
  if [[ "$code" != 204 ]]; then code=$(curl --proxy "$p" --connect-timeout 5 --max-time 15 -sS -o /dev/null -w '%{http_code}' https://github.com/ 2>/dev/null || true); [[ "$code" =~ ^(200|301|302)$ ]] || return 1; fi
  ip=$(curl --proxy "$p" --connect-timeout 5 --max-time 10 -sS https://api.ipify.org 2>/dev/null || true); [[ -n "$ip" ]] && info "代理出口 IP: $ip"; return 0
}
test_current(){ running || die "sing-box 未运行。"; local port; port=$(envval SING_BOX_MIXED_PORT 7890); http_test "http://127.0.0.1:$port" && info "当前代理测试通过。" || die "当前代理测试失败。"; }
test_node(){
  local ref="${1:-}" t c image port rc=0; t=$(mktemp -d); c="sbx-node-test-$$"; image="ghcr.io/sagernet/sing-box:$(envval SING_BOX_VERSION v1.14.2)"
  python3 "$HELPER" test-config ${ref:+"$ref"} --output "$t/config.json" --port 7891 || { rm -rf "$t"; return 1; }
  docker run --rm -v "$t:/etc/sing-box:ro" "$image" check -c /etc/sing-box/config.json -D /tmp/sing-box || { rm -rf "$t"; return 1; }
  docker run -d --rm --name "$c" -p '127.0.0.1::7891/tcp' -v "$t:/etc/sing-box:ro" "$image" -D /tmp/sing-box -c /etc/sing-box/config.json run >/dev/null || { rm -rf "$t"; return 1; }
  sleep 1; port=$(docker port "$c" 7891/tcp 2>/dev/null | head -n1 | awk -F: '{print $NF}')
  [[ -n "$port" ]] && http_test "http://127.0.0.1:$port" || rc=1
  ((rc)) && { warn "节点测试失败，临时日志："; docker logs "$c" 2>&1 | tail -n40 || true; } || info "节点完整代理测试通过。"
  docker rm -f "$c" >/dev/null 2>&1 || true; rm -rf "$t"; return "$rc"
}
node(){
  local op="${1:-menu}" ref="${2:-}"
  case "$op" in
    list|ls) python3 "$HELPER" list;;
    add|edit|delete|del|rm|default|use) case "$op" in del|rm) op=delete;; use) op=default;; esac; node_tx "$op" "$ref";;
    show) python3 "$HELPER" show ${ref:+"$ref"};;
    test) test_node "$ref";;
    render) backup; python3 "$HELPER" render >/dev/null; check; running && restart || true;;
    help|-h|--help) cat <<'__NODEHELP__'
sbx node list | add | edit [ID|name] | delete [ID|name]
sbx node default [ID|name] | show [ID|name] | test [ID|name] | render
__NODEHELP__
      ;;
    menu) node_menu;;
    *) die "未知 node 命令: $op";;
  esac
}
version(){ printf 'singbox-manager: %s\npinned sing-box: %s\n' "$VERSION" "$(envval SING_BOX_VERSION v1.14.2)"; }
upgrade(){
  local new="${1:-}" old; [[ -n "$new" ]] || die "用法: sbx upgrade v1.14.2"; [[ "$new" == v* ]] || new="v$new"; [[ "$new" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || die "版本格式无效"; old=$(envval SING_BOX_VERSION v1.14.2); backup; setenv SING_BOX_VERSION "$new"
  if ! dc pull sing-box || ! check || ! dc up -d --force-recreate sing-box; then setenv SING_BOX_VERSION "$old"; dc up -d --force-recreate sing-box >/dev/null 2>&1 || true; die "升级失败，已尝试回滚到 $old"; fi; version
}
pull(){ backup; dc pull sing-box; check; dc up -d --force-recreate sing-box; }
edit(){ local e="${SBX_EDITOR:-${EDITOR:-vi}}"; command -v "$e" >/dev/null || die "找不到编辑器 $e"; backup; warn "config.json 由节点库生成，后续节点操作会覆盖手工改动。"; "$e" "$CONFIG"; check; }

pause(){ read -r -p '按 Enter 返回...' _ || true; }
node_menu(){ local x r; while true; do clear; printf '%b节点管理%b\n1 查看  2 添加  3 编辑  4 删除\n5 默认  6 详情  7 测试  8 重建配置  0 返回\n' "$C" "$N"; read -r -p '请选择: ' x || return; case "$x" in 1) node list;;2) node_tx add;;3) read -r -p 'ID/名称(留空后选择): ' r; node_tx edit "$r"||true;;4) read -r -p 'ID/名称(留空后选择): ' r; node_tx delete "$r"||true;;5) read -r -p 'ID/名称(留空后选择): ' r; node_tx default "$r"||true;;6) read -r -p 'ID/名称(留空后选择): ' r; python3 "$HELPER" show ${r:+"$r"}||true;;7) read -r -p 'ID/名称(留空后选择): ' r; test_node "$r"||true;;8) node render;;0) return;;*) warn "无效选项";; esac; [[ "$x" != 0 ]] && pause; done; }
menu(){ local x v f; while true; do clear; printf '%b' "$C"; cat <<'__MENU__'
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        singbox-manager 0.2
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
1 状态   2 启动   3 停止   4 重启   5 日志
6 节点管理          7 检查配置   8 测试代理
9 备份   10 恢复   11 版本      12 升级
13 拉取当前版本     14 高级编辑配置
0 退出
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
__MENU__
    printf '%b' "$N"; read -r -p '请选择: ' x || exit; case "$x" in 1) status;;2) start;;3) stop;;4) restart;;5) logs||true;;6) node_menu; continue;;7) check||true;;8) test_current||true;;9) backup;;10) read -r -p '备份文件(留空最新): ' f; restore "$f"||true;;11) version;;12) read -r -p '目标版本: ' v; [[ -n "$v" ]]&&upgrade "$v"||true;;13) pull;;14) edit||true;;0) exit;;*) warn "无效选项";; esac; pause; done; }
help(){ cat <<'__HELP__'
sbx                    交互菜单
sbx node               节点管理菜单
sbx node add/list/edit/delete/default/show/test
sbx status/start/stop/restart/logs/check/test
sbx backup/restore [file]
sbx version/upgrade <version>/pull
__HELP__
}

main(){ root "$@"; ready; local cmd="${1:-menu}"; shift||true; case "$cmd" in menu)menu;;node)node "$@";;status|ps)status;;start|up)start;;stop|down)stop;;restart)restart;;logs|log)logs;;check)check;;test)test_current;;backup)backup;;restore)restore "${1:-}";;version|-v|--version)version;;upgrade)upgrade "${1:-}";;pull|update)pull;;edit|config)edit;;help|-h|--help)help;;*)die "未知命令: $cmd";;esac; }
[[ -f "$HOME_DIR/lib/sbx_v3.sh" ]] && source "$HOME_DIR/lib/sbx_v3.sh"
[[ -f "$HOME_DIR/lib/sbx_proxy.sh" ]] && source "$HOME_DIR/lib/sbx_proxy.sh"
[[ -f "$HOME_DIR/lib/sbx_bootstrap.sh" ]] && source "$HOME_DIR/lib/sbx_bootstrap.sh"
[[ -f "$HOME_DIR/lib/sbx_image.sh" ]] && source "$HOME_DIR/lib/sbx_image.sh"
[[ -f "$HOME_DIR/lib/sbx_inbound.sh" ]] && source "$HOME_DIR/lib/sbx_inbound.sh"
[[ -f "$HOME_DIR/lib/sbx_update.sh" ]] && source "$HOME_DIR/lib/sbx_update.sh"
if [[ "${1:-}" == "image" ]]; then
  root "$@"
  ready
  shift || true
  image_cmd "$@"
else
  main "$@"
fi
