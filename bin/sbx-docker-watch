#!/usr/bin/env bash
set -Eeuo pipefail

SBX_WATCH_SBX="${SBX_WATCH_SBX:-/usr/local/bin/sbx}"
SBX_WATCH_RETRY="${SBX_WATCH_RETRY:-3}"

while true; do
  if ! command -v docker >/dev/null 2>&1; then
    sleep "$SBX_WATCH_RETRY"
    continue
  fi

  # 路径写错时不能静默空转：否则 unit 一直 active 却永远不生效
  if [[ ! -x "$SBX_WATCH_SBX" ]]; then
    printf 'sbx 不可执行: %s（%s 秒后重试）\n' "$SBX_WATCH_SBX" "$SBX_WATCH_RETRY" >&2
    sleep "$SBX_WATCH_RETRY"
    continue
  fi

  # docker events 在 daemon 重启时会非零退出；不能让它用 errexit 结束整个 watcher
  # （只靠 systemd 的 Restart=always 兜底不够，手工运行时就是静默死掉）。
  #
  # 刻意不用 --format：模板字段跨 Docker 版本会变。曾经写 --format '{{.ID}}'，
  # Docker 26 起 *events.Message 去掉了废弃的 ID 字段（要用 Actor.ID），于是
  # docker events 一启动就以 "Error parsing format" 退出，而错误被 2>/dev/null 吞掉，
  # 结果 unit 显示 active、却一次 sync 都没跑过。事件行本身不需要解析。
  docker events \
    --filter type=container \
    --filter event=create \
    --filter event=start |
  while IFS= read -r _event; do
    # 加前缀后原样写进 journalctl：接入成功/失败都要看得见，不再静默
    "$SBX_WATCH_SBX" docker-network sync 2>&1 | sed 's/^/[sbx-docker-watch] /' || true
  done || true

  sleep "$SBX_WATCH_RETRY"
done
